# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=rgames
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/rgames

# JWT Configuration
# JWT_SECRET: obligatorio, >= 32 caracteres random (openssl rand -hex 32). El boot falla si
# falta o es débil (ver main.ts validateEnv).
JWT_SECRET=your-secret-key-here-change-in-production

# Access token (JWT corto, en el body de login/refresh). Formato aceptado por la lib `ms`
# (ej: "20m", "6h"). Default en el código si no está: 6h (transicional, ver auth.module.ts).
ACCESS_TOKEN_TTL=6h

# Refresh token (opaco, httpOnly cookie, guardado hasheado en DB). Default en el código: 30.
REFRESH_TOKEN_TTL_DAYS=30

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,https://royalgames.lat

# Cloudinary Configuration
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Configuration (Gmail)
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# URL del front: a dónde redirigen /mercadopago/success|failure|pending del backend.
# Desarrollo: http://localhost:5173
FRONTEND_URL=https://royalgames.lat

# MercadoPago: una cuenta vendedora por país (una moneda de liquidación cada una),
# usadas por /mepago/create-order/ar|co|mx.
# Desarrollo: tokens TEST-... (o de usuarios de prueba). Producción: tokens APP_USR-... reales.
MERCADOPAGO_ACCESS_TOKEN_AR=your_mercadopago_access_token_argentina
MERCADOPAGO_ACCESS_TOKEN_CO=your_mercadopago_access_token_colombia
MERCADOPAGO_ACCESS_TOKEN_MX=your_mercadopago_access_token_mexico

# Opcional: otra cuenta cuyos pagos el webhook también puede consultar.
MERCADOPAGO_ACCESS_TOKEN=

# Retorno del usuario tras pagar (rutas /mercadopago/... del front o del backend).
# Si contienen "localhost" no se envían a Mercado Pago (no acepta back_urls locales).
MERCADOPAGO_SUCCESS_URL=https://royalgames.lat/mercadopago/success
MERCADOPAGO_FAILURE_URL=https://royalgames.lat/mercadopago/failure
MERCADOPAGO_PENDING_URL=https://royalgames.lat/mercadopago/pending

# Webhook: tiene que ser una URL pública. En desarrollo: ngrok http 3001 → https://<ngrok>/mepago/webhook
MERCADOPAGO_NOTIFICATION_URL=https://royalgamesbackend.onrender.com/mepago/webhook

# Clave secreta de webhooks de cada cuenta (Mercado Pago → Tus integraciones → Webhooks).
# Si hay al menos una, /mepago/webhook rechaza notificaciones v2 sin firma válida.
# Vacías = no se valida la firma (solo para desarrollo).
MERCADOPAGO_WEBHOOK_SECRET_AR=
MERCADOPAGO_WEBHOOK_SECRET_CO=
MERCADOPAGO_WEBHOOK_SECRET_MX=

# PayPal: sandbox en desarrollo, live en producción. Las credenciales y el
# VITE_PAYPAL_CLIENT_ID del front tienen que ser del mismo entorno que PAYPAL_MODE.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_SUCCESS_URL=https://royalgames.lat/chips
PAYPAL_CANCEL_URL=https://royalgames.lat/chips

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
